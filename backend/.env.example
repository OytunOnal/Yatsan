# Copy to backend/.env and fill in.

# Postgres — matches docker-compose.yml defaults for local dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teknepazari

# Server
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# Auth — use a long random string
JWT_SECRET=change-me-to-a-long-random-string

# Transactional email (verification / password reset) — https://resend.com
RESEND_API_KEY=
